<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="400"
        Background="#f1f1fa">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Slider color maker" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,50"/>

            <TextBlock Text="Red" FontSize="24" FontWeight="Bold" Margin="5,0,5,0"/>
            <Slider x:Name="sliderRed" Minimum="0" Maximum="255" Value="0" Margin="5,0,5,0" ValueChanged="sliderChange"/>
            
            <TextBlock Text="Green" FontSize="24" FontWeight="Bold" Margin="5,20,5,0"/>
            <Slider x:Name="sliderGreen" Minimum="0" Maximum="255" Value="0" Margin="5,0,5,0" ValueChanged="sliderChange"/>
            
            <TextBlock Text="Blue" FontSize="24" FontWeight="Bold" Margin="5,20,5,0"/>
            <Slider x:Name="sliderBlue" Minimum="0" Maximum="255" Value="0" ValueChanged="sliderChange"/>

            <Border x:Name="colorPreview" Height="200" Background="#000000" CornerRadius="20" BorderBrush="white" BorderThickness="5" Margin="5,50,5,5">
                <TextBlock Text="SZÍN MINTA" x:Name="txtColorPreview" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="white"></TextBlock>
            </Border>

            <Border Background="white" CornerRadius="20" Margin="0,20,0,0" Padding="15">
                <TextBlock x:Name="txtRGB" Text="RGB 0, 0, 0" HorizontalAlignment="Center" FontSize="16" Foreground="Black" ></TextBlock>
            </Border>

        </StackPanel>
    </Grid>
</Window>
